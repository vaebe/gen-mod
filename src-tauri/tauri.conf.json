{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GenMod",
  "version": "0.1.0",
  "identifier": "com.ygdpz.gen-mod",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GenMod",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../runtime/resources/node-v22.19.0-win-x64/": "runtime/node-v22.19.0-win-x64/",
      "../runtime/resources/pi-portable-v1.1.0/": "runtime/pi-portable-v1.1.0/",
      "../runtime/resources/resource-manifest.json": "runtime/resource-manifest.json",
      "../skills/": "skills/"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
